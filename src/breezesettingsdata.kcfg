<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name="mkpolarisedgerc"/>

  <!-- shadow (the mkAurorae themes have none: Shadow=false) -->
  <group name="Common">

    <entry name="ShadowStrength" type = "Int">
       <default>255</default>
       <min>25</min>
       <max>255</max>
    </entry>

    <entry name="ShadowSize" type = "Enum">
      <choices>
          <choice name="ShadowNone"/>
          <choice name="ShadowSmall"/>
          <choice name="ShadowMedium"/>
          <choice name="ShadowLarge"/>
          <choice name="ShadowVeryLarge"/>
      </choices>
      <default>ShadowNone</default>
    </entry>

    <entry name="ShadowColor" type = "Color">
       <default>0, 0, 0</default>
    </entry>

  </group>

  <group name="Windeco">

    <entry name="TitleAlignment" type="Enum">
      <choices>
          <choice name="AlignLeft" />
          <choice name="AlignCenter" />
          <choice name="AlignCenterFullWidth" />
          <choice name="AlignRight" />
      </choices>
      <default>AlignLeft</default>
    </entry>

    <!-- highlight of the active window: a colored line instead of the gray one, as in the color variants of the
         mkAurorae themes; HighlightNone keeps the gray line (as for inactive windows, the gray mkAurorae theme) -->
    <entry name="ActiveHighlight" type="Enum">
      <choices>
          <choice name="HighlightNone" />
          <choice name="HighlightAccent" />
          <choice name="HighlightPurple" />
          <choice name="HighlightRed" />
          <choice name="HighlightCustom" />
      </choices>
      <default>HighlightPurple</default>
    </entry>

    <entry name="ActiveHighlightCustomColor" type="Color">
      <default>133, 0, 247</default>
    </entry>

    <!-- width of the highlight line, in pixel rows of the 4 px frame: 1 the thin line in pixel 1, 2 the bold line in
         pixels 0 and 1 (the "B" variants), 3 and 4 grow one row further in each (4 covers the whole frame).
         Switched off by ActiveHighlight HighlightNone. Replaces ActiveHighlightBold of version 1.0 (true: 2), see loadSettings() in breeze.h. -->
    <entry name="ActiveHighlightWidth" type="Int">
      <default>1</default>
      <min>1</min>
      <max>4</max>
    </entry>

    <!-- radius of the highlight corners at pixel edge 0, the outer edge of the frame (also when the highlight starts
         further in, as the thin line in pixel 1); every pixel edge further in has a radius 1 smaller, down to 0 (all corner arcs are
         concentric). 4 is the look of the mkAurorae themes, 0 square corners. Up to 8 the corner stays inside the
         4 px frame at the bottom, where the window content begins. -->
    <entry name="ActiveHighlightRadius" type="Int">
      <default>4</default>
      <min>0</min>
      <max>8</max>
    </entry>

    <!-- blend the rounded corners of the highlight in linear light. QPainter blends gamma-encoded values, which makes
         the mixed pixels of a light line over the dark frame too dark, but matches the mkAurorae themes more closely. -->
    <entry name="HighQualityRendering" type="Bool">
      <default>true</default>
    </entry>

  </group>

</kcfg>
