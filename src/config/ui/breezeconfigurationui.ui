          <cstring>highlightRadius</cstring>
         </property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QSpinBox" name="highlightRadius">
         <property name="toolTip">
          <string>Radius of the rounded corners of the highlight, at the outer edge of the frame (the thin line starts 1 px further in: 1 px less; 0: square corners)</string>
         </property>
         <property name="suffix">
          <string> px</string>
         </property>
         <property name="minimum">
          <number>0</number>
