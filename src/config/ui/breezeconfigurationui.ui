         </property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QSpinBox" name="highlightWidth">
         <property name="toolTip">
          <string>Width of the highlight line: 1 thin, 2 bold as in the B variants of the mkAurorae themes, 3 and 4 grow one row further in each (4 covers the whole frame)</string>
         </property>
         <property name="suffix">
          <string> px</string>
         </property>
         <property name="minimum">
          <number>1</number>
         </property>
         <property name="maximum">
          <number>4</number>
         </property>
        </widget>
       </item>
