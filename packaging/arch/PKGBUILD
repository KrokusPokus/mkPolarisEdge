# Maintainer: KrokusPokus
#
# Baut den aktuellen Stand des Standard-Branches von GitHub.
# Bauen und installieren: makepkg -si   (danach KWin neu laden, siehe .install)

pkgname=mkpolarisedge-git
_pkgname=mkPolarisEdge
pkgver=r0.0000000
pkgrel=1
pkgdesc='KWin window decoration based on Breeze'
arch=('x86_64')
url='https://github.com/KrokusPokus/mkPolarisEdge'
license=('GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL')
depends=(
  'glibc'
  'kcmutils'
  'kcolorscheme'
  'kconfig'
  'kconfigwidgets'
  'kcoreaddons'
  'kdecoration'
  'kguiaddons'
  'ki18n'
  'kiconthemes'
  'kwindowsystem'
  'libstdc++'
  'qt6-base'
  'qt6-svg'
)
makedepends=(
  'cmake'
  'extra-cmake-modules'
  'git'
)
provides=('mkpolarisedge')
conflicts=('mkpolarisedge')
install=mkpolarisedge.install
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cmake -B build -S "$_pkgname" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF \
    -Wno-dev
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$_pkgname"/LICENSES/*
}
